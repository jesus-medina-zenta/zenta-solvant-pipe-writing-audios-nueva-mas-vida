# Variables de entorno de ejemplo
# Copia este archivo a .env y ajusta los valores según tu configuración

# Configuración general
APP_NAME=zenta-template-pipe-python
LOG_LEVEL=INFO
ENVIRONMENT=dev

# Configuración de procesamiento
BATCH_SIZE=1000
MAX_RETRIES=3
RETRY_DELAY=5

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=mi_base_datos
POSTGRES_USER=mi_usuario
POSTGRES_PASSWORD=mi_password

# Google Cloud / BigQuery
BIGQUERY_PROJECT_ID=mi-proyecto-gcp
BIGQUERY_DATASET=mi_dataset
BIGQUERY_TABLE=mi_tabla
BIGQUERY_LOCATION=US

# Opcional: Para autenticación de Google Cloud
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
